# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated API reference (scripts/build_docs.py --output-dir site); CI
# builds it fresh and publishes it, so a local copy is never committed.
site/

# Coverage / pytest / tooling caches
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Hypothesis example database (property-test counterexamples found locally).
.hypothesis/
.tmp/

# Downloaded model weights. ``brailix.core.models.paths`` resolves the dev
# root to ``<cwd>/models/``, and g2pw writes ``G2PWModel/`` beside it — so
# running the suite with the heavy engines installed (``--all-extras``, or the
# scheduled deep-verify job) leaves several hundred MB at the repo root.
# Anchored with a leading slash: an unanchored ``models/`` would also match the
# tracked ``brailix/core/models/`` package.
/models/
/G2PWModel/

# Editors
*.swp
.idea/
.vscode/
